{
  "name": "mywiki",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/happy80064-beep/my-wiki.git"
  },
  "scripts": {
    "dev": "vite",
    "build:windows": "tsc --noEmit && vite build && powershell -ExecutionPolicy Bypass -File scripts/copy-ocr-assets.ps1",
    "build:macos": "tsc --noEmit && vite build && bash scripts/copy-ocr-assets-macos.sh",
    "desktop:dev": "tauri dev",
    "desktop:build:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-markitdown-sidecar.ps1 && tauri build",
    "desktop:build:macos": "bash scripts/build-markitdown-sidecar-macos.sh && tauri build --config src-tauri/tauri.macos.conf.json --bundles app,dmg",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-window-state": "~2.4.1",
    "@vitejs/plugin-react": "^6.0.1",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.11.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "tesseract.js": "^7.0.0",
    "three": "^0.184.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
